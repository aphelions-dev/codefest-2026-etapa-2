# Copiar a .env y rellenar. El .env no se versiona.

# Postgres local (docker-compose)
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://radar:<POSTGRES_PASSWORD>@localhost:5432/radar

# Endpoint de modelos, compatible con OpenAI. El backend solo conoce estas cuatro variables, asi que
# cambiar de proveedor es cambiar el .env, nunca el codigo.
#
#   En el reto:    el proxy LiteLLM de la organizacion
#                  LITELLM_BASE_URL=https://litellm.admin-adl.codefest2026.augusta.avaldigitallabs.com
#                  FAST_MODEL=openai/gpt-oss-20b
#                  DEEP_MODEL=openai/gpt-oss-120b
#
#   En desarrollo: cualquier endpoint compatible con OpenAI, para no gastar el presupuesto del reto.
#
# Aviso medido: gpt-oss razona antes de responder y el razonamiento cuenta como tokens de salida.
# Con max_tokens ajustado se gasta el presupuesto razonando y no emite nada. `reasoning_effort: low`
# recorta ~35% la salida del modelo pequeno sin perder la llamada a herramienta.
LITELLM_BASE_URL=
LITELLM_API_KEY=
FAST_MODEL=
DEEP_MODEL=

# Proveedor de los modelos, tal como lo declara la ficha del agente (seccion 2.3).
PROVIDER=openai

# URL publica que declara la ficha. Tiene que coincidir con el subdominio agent. de Coolify.
AGENT_ENDPOINT=http://localhost:8000/chat

# `false` levanta el servicio sin cargar el encoder: el tablero funciona y solo el agente de corpus
# queda sin responder. Util para arrancar rapido o en una maquina sin memoria para el modelo.
LOAD_INDEX=true

# Origenes permitidos por el backend, separados por coma.
CORS_ORIGINS=http://localhost:3000
