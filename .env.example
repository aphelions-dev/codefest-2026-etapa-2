# Copiar a .env y rellenar. El .env no se versiona.

# --- Base de datos -------------------------------------------------------------------------------
# Postgres con pgvector. Contiene el indice de la Etapa 1 en la tabla `fragments`.
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://radar:<POSTGRES_PASSWORD>@localhost:5432/radar

# --- Modelos -------------------------------------------------------------------------------------
# Endpoint compatible con OpenAI. El backend solo conoce estas cuatro variables, asi que cambiar de
# proveedor es cambiar el .env, nunca el codigo.
#
#   En el reto:    el proxy LiteLLM de la organizacion
#                  LITELLM_BASE_URL=https://litellm.admin-adl.codefest2026.augusta.avaldigitallabs.com/v1
#
#   En desarrollo: cualquier endpoint compatible con OpenAI, para no gastar el presupuesto del reto.
LITELLM_BASE_URL=
LITELLM_API_KEY=

# Los identificadores EXACTOS que expone el proxy. No se suponen: se consultan, porque el alias
# cambia entre el gateway local y el del reto, y un identificador que el proxy no conoce no falla
# hasta la primera consulta.
#
#   curl -s -H "Authorization: Bearer $LITELLM_API_KEY" "$LITELLM_BASE_URL/models"
#
# El barato para guardianes y verificador; el grande solo para enrutar, descomponer y redactar.
# El presupuesto es en dinero: si se agota, la clave deja de responder y no hay demo.
#
# Aviso medido: gpt-oss razona antes de responder y el razonamiento cuenta como tokens de salida.
# Con max_tokens ajustado se gasta el presupuesto razonando y no se emite nada. El codigo no lo
# ajusta nunca y pide `reasoning_effort: low`, que recorta ~35% la salida del modelo pequeno.
FAST_MODEL=
DEEP_MODEL=

# --- API -----------------------------------------------------------------------------------------
# Origenes permitidos por el backend, separados por coma. En Coolify, los dos subdominios del
# frontend: el del chat y el del tablero.
CORS_ORIGINS=http://localhost:3000

# --- Recuperacion (opcional) ---------------------------------------------------------------------
# Valores medidos en la Etapa 1. Solo se tocan con una medicion delante.
# HNSW_EF_SEARCH=400
# EVIDENCE_THRESHOLD=0.52
# TOP_K=12
# MAX_FRAGMENTS_PER_DOC=2
# MAX_RETRIES=2
